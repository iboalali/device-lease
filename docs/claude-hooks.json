{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/devicelease hook pre-bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__device_open",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/devicelease hook pre-device-open",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__t3-code__device_close",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/devicelease hook post-device-close",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|mcp__t3-code__device_.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/devicelease hook heartbeat",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/devicelease hook session-end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
