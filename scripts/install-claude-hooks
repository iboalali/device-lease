#!/usr/bin/env python3
"""Adds the devicelease hooks to ~/.claude/settings.json, keeping a backup and any other hooks.

Running it again replaces the entries that call `devicelease hook` instead of duplicating them.
"""

import json
import os
import shutil
import sys
from pathlib import Path

SETTINGS = Path.home() / ".claude" / "settings.json"
COMMAND = str(Path.home() / ".local" / "bin" / "devicelease") + " hook "

HOOKS = {
    "PreToolUse": [
        ("Bash", "pre-bash"),
        ("mcp__t3-code__device_open", "pre-device-open"),
    ],
    "PostToolUse": [
        ("mcp__t3-code__device_close", "post-device-close"),
        ("Bash|mcp__t3-code__device_.*", "heartbeat"),
    ],
    "SessionEnd": [
        (None, "session-end"),
    ],
}


def is_ours(group: dict) -> bool:
    return any("devicelease hook " in h.get("command", "") for h in group.get("hooks", []))


def main() -> int:
    settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    hooks = settings.setdefault("hooks", {})
    for event, entries in HOOKS.items():
        groups = [g for g in hooks.get(event, []) if not is_ours(g)]
        for matcher, name in entries:
            group = {"hooks": [{"type": "command", "command": COMMAND + name, "timeout": 30}]}
            if matcher:
                group = {"matcher": matcher, **group}
            groups.append(group)
        hooks[event] = groups

    if SETTINGS.exists():
        backup = SETTINGS.with_name("settings.json.bak-devicelease")
        shutil.copy2(SETTINGS, backup)
        print(f"Backup: {backup}")
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    temp = SETTINGS.with_name("settings.json.tmp")
    temp.write_text(json.dumps(settings, indent=2) + "\n")
    os.replace(temp, SETTINGS)
    print(f"Added devicelease hooks to {SETTINGS}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
